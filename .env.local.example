# MainStreet Metrics — environment variables
# Copy this file to .env.local and paste values from your Supabase project.
#
#   Supabase Dashboard → Project Settings → API
#
# IMPORTANT: never commit .env.local. The service role key bypasses RLS.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — bypasses RLS. Imported only by lib/supabase/admin.ts
# (guarded by `import "server-only"`). Never expose to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
