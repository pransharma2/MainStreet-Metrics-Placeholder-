# MainStreet Metrics — environment variables
# Copy this file to .env.local and paste values from your Supabase project settings.
#
#   Supabase Dashboard → Project Settings → API
#

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key

# Server-only (NEVER expose to the browser; used only in server actions / route handlers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...your-service-role-key

# Public site URL (used for OAuth redirect callbacks in later phases)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
